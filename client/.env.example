# FlowFunds frontend environment variables.
# Copy this file to `.env` (or `.env.local`) for local overrides. Never commit real `.env` files.

# Base URL of the FlowFunds backend API (no trailing slash).
#
# Development: optional. Defaults to http://localhost:3001 when unset.
# Production (Vercel): REQUIRED. Set it to the deployed Render API URL, e.g.
#   https://flowfunds-api.onrender.com
# A production build with no VITE_API_URL will throw at startup instead of
# silently calling localhost.
VITE_API_URL="http://localhost:3001"
