# FlowFunds API environment variables.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
# Local development: a local PostgreSQL instance or a Neon development branch.
# Production: the Neon connection string (use the pooled connection string).
# The value below is a placeholder — replace every UPPERCASE part.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# Port the API listens on. Render sets this automatically in production;
# 3001 is the local default when unset.
PORT=3001

# Set to "production" when deploying (Render). Leave unset/development locally.
NODE_ENV=development

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
# In development the local Vite dev server (http://localhost:5173) is always allowed.
# In production set this to your deployed frontend origin.
CLIENT_ORIGIN="https://your-frontend.vercel.app"
